# Copy to .env and edit. Never commit .env.

# --- Security ---
# Comma-separated API keys accepted in the X-API-Key header. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=change-me-to-a-long-random-string
# Comma-separated allowed CORS origins ("*" = any; avoid in production)
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=50000000
# Requests per minute per client IP (0 disables)
RATE_LIMIT_PER_MINUTE=120

# --- Storage (on the host: your SSD/HDD folder) ---
# Used by docker compose as the bind-mount source, e.g. D:/AIImageData
HOST_STORAGE_DIR=./storage
# Path inside the app/container (leave as is for Docker)
STORAGE_DIR=./storage

# --- Model ---
YOLO_MODEL=yolo11n.pt
# auto = CUDA if available else CPU. Or: cpu, cuda:0, 0
YOLO_DEVICE=auto
YOLO_CONF=0.25
YOLO_IOU=0.45
YOLO_IMGSZ=640
YOLO_HALF=true
# Load the model at startup (true) or on first request (false)
PRELOAD_MODEL=true

# --- Optional Azure Blob Storage backup ---
AZURE_ENABLED=false
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER=image-processing
# Upload automatically after each processed image
AZURE_AUTO_UPLOAD=true
